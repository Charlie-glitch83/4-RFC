{
  "schema_version": "2.0",
  "module": "G",
  "title": "Nonequilibrium Recombination and Last-Scattering State",
  "parents": [
    "F"
  ],
  "children": [
    "HU",
    "I"
  ],
  "objective": "Generate recombination, visibility, opacity, and radiation-surface histories from the physical plasma state.",
  "nbody_mode": "RELATIONAL_GRAMMAR_ACTIVE",
  "triadic_descent": {
    "CIF": "bound/free-state possibilities",
    "QV": "recombination, ionization and opacity evolution",
    "RFL": "visibility and radiation surface"
