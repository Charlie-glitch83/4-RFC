{
  "schema_version": "2.0",
  "module": "HI",
  "title": "Transfer Operator Instantiation",
  "parents": [
    "HU",
    "I"
  ],
  "children": [
    "J"
  ],
  "objective": "Instantiate the frozen universal transfer operator on the realized background without changing either parent's law.",
  "nbody_mode": "RELATIONAL_GRAMMAR_ACTIVE",
  "triadic_descent": {
    "CIF": "HU operator and I background",
    "QV": "type-safe instantiation",
    "RFL": "immutable composite transfer system"
  },
  "derive_exactly": [
    "exact parent type compatibility",
    "operator/background composition without modifying either parent",
    "mode/eigenstructure and covariance propagation"
  ],
  "wolfram_calls": [
    "HI-WL-001",
    "HI-WL-002"
  ],
  "local_commands": [
    "python tools/run_reference_checks.py --module HI --output <RUN_DIR>/reference_checks.json",
    "python tools/director.py solver-copy --module HI --solver linear_transfer --destination <RUN_DIR>",
    "python tools/materialize_solver_config.py --template <RUN_DIR>/solver_templates/HI_instantiated_transfer.template.json --binding-sheet <RUN_DIR>/binding_sheets/HI_instantiated_transfer.bindings.json --output <RUN_DIR>/solver_configs/HI_instantiated_transfer.json",
    "python tools/run_configured_solver.py --config <RUN_DIR>/solver_configs/HI_instantiated_transfer.json --output-dir <RUN_DIR>/solver_outputs/linear_transfer"
  ],
  "numerical_execution": [
    "parent-hash check",
    "composition/reconstruction test",
    "independent instantiation"
  ],
  "required_outputs": [
    "instantiated transfer system",
    "mode/eigenstructure",
    "gauge/frame mapping",
    "error/covariance propagation",
    "H_HI_to_J"
  ],
  "mandatory_gates": [
    "exact parent hashes",
    "no retune of HU or I",
    "operator-domain compatibility",
    "independent reconstruction"
  ],
  "forbidden_shortcuts": [
    "refitting transfer coefficients after seeing spectra"
  ],
  "hard_stop_conditions": [
    "HU or I are changed during instantiation",
    "domain/codomain mismatch",
    "retuning appears"
  ],
  "claim_boundary": "RFC linear transfer realization.",
  "operator_sequence": [
    "freeze exact parents and source hashes",
    "complete PRE_EXECUTION_LOCK.json before derivation execution",
    "run Wolfram calls in listed order and record outputs",
    "run manufactured reference checks",
    "derive/execute the actual parent-driven system",
    "run countermodels, ablations, convergence, restart, replay and independent reconstruction",
    "finalize output manifest only after files stop changing",
    "state strongest supported and unsupported claims",
    "commit and verify SHA/diff"
  ],
  "solver_bindings": [
    {
      "solver": "linear_transfer",
      "template": "configured_runs/templates/HI_instantiated_transfer.template.json",
      "purpose": "Instantiate the frozen transfer operator on the exact realized background.",
      "copy_command": "python tools/director.py solver-copy --module HI --solver linear_transfer --destination <RUN_DIR>",
      "run_command": "python tools/run_configured_solver.py --config <RUN_DIR>/solver_configs/HI_instantiated_transfer.json --output-dir <RUN_DIR>/solver_outputs/linear_transfer",
      "status": "UNBOUND_UNTIL_EXACT_PARENT_DERIVATION",
      "binding_sheet": "configured_runs/binding_sheets/HI_instantiated_transfer.bindings.json",
      "materialize_command": "python tools/materialize_solver_config.py --template <RUN_DIR>/solver_templates/HI_instantiated_transfer.template.json --binding-sheet <RUN_DIR>/binding_sheets/HI_instantiated_transfer.bindings.json --output <RUN_DIR>/solver_configs/HI_instantiated_transfer.json"
    }
  ]
}
