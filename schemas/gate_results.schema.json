{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "gates",
    "overall"
  ],
  "properties": {
    "overall": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "gates": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
