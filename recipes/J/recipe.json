      "materialize_command": "python tools/materialize_solver_config.py --template <RUN_DIR>/solver_templates/J_fourier_field.template.json --binding-sheet <RUN_DIR>/binding_sheets/J_fourier_field.bindings.json --output <RUN_DIR>/solver_configs/J_fourier_field.json"
