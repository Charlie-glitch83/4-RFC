{
  "schema_version": "2.0",
  "module": "I",
  "title": "Realized Background Geometry and Expansion",
  "parents": [
    "G"
  ],
  "children": [
    "HI"
  ],
  "objective": "Generate the universe's realized geometry, expansion, clocks, horizons, and distance structure from the accumulated physical state.",
  "nbody_mode": "RELATIONAL_GRAMMAR_ACTIVE",
  "triadic_descent": {
    "CIF": "global physical configuration possibilities",
    "QV": "constraint-satisfying geometry and clock evolution",
    "RFL": "realized background, horizon and distance memory"
  },
  "derive_exactly": [
    "background variables and frames from G",
    "geometry/expansion evolution and constraints",
    "intrinsic clocks, horizons and distances",
    "covariance and restart state"
  ],
  "wolfram_calls": [
    "I-WL-001",
    "I-WL-002"
  ],
  "local_commands": [
    "python tools/run_reference_checks.py --module I --output <RUN_DIR>/reference_checks.json",
    "python tools/director.py solver-copy --module I --solver transport --destination <RUN_DIR>",
    "python tools/materialize_solver_config.py --template <RUN_DIR>/solver_templates/I_background_ode.template.json --binding-sheet <RUN_DIR>/binding_sheets/I_background_ode.bindings.json --output <RUN_DIR>/solver_configs/I_background_ode.json",
    "python tools/run_configured_solver.py --config <RUN_DIR>/solver_configs/I_background_ode.json --output-dir <RUN_DIR>/solver_outputs/transport"
  ],
  "numerical_execution": [
    "constraint residual convergence",
    "gauge/frame consistency",
    "distance/horizon identities and independent solver"
  ],
  "required_outputs": [
    "metric/background state",
    "expansion and clock histories",
    "horizons and distances",
    "constraint and conservation ledgers",
    "covariance",
    "H_I_to_HI"
  ],
  "mandatory_gates": [
    "equation/constraint derivation",
    "gauge/frame consistency",
    "no observed expansion history used as target",
    "numerical convergence and independent reconstruction"
  ],
  "forbidden_shortcuts": [
    "inserting LambdaCDM best-fit parameters",
    "calling a standard background RFC-derived without proof"
  ],
  "hard_stop_conditions": [
    "observed expansion history is used as target",
    "clock/frame ambiguity unresolved",
    "constraint residual fails"
  ],
  "claim_boundary": "Realized RFC background geometry.",
  "operator_sequence": [
    "freeze exact parents and source hashes",
    "complete PRE_EXECUTION_LOCK.json before derivation execution",
    "run Wolfram calls in listed order and record outputs",
    "run manufactured reference checks",
    "derive/execute the actual parent-driven system",
    "run countermodels, ablations, convergence, restart, replay and independent reconstruction",
    "finalize output manifest only after files stop changing",
    "state strongest supported and unsupported claims",
    "commit and verify SHA/diff"
  ],
  "solver_bindings": [
    {
      "solver": "transport",
      "template": "configured_runs/templates/I_background_ode.template.json",
      "purpose": "Integrate the internally derived background geometry/clock system.",
      "copy_command": "python tools/director.py solver-copy --module I --solver transport --destination <RUN_DIR>",
      "run_command": "python tools/run_configured_solver.py --config <RUN_DIR>/solver_configs/I_background_ode.json --output-dir <RUN_DIR>/solver_outputs/transport",
      "status": "UNBOUND_UNTIL_EXACT_PARENT_DERIVATION",
      "binding_sheet": "configured_runs/binding_sheets/I_background_ode.bindings.json",
      "materialize_command": "python tools/materialize_solver_config.py --template <RUN_DIR>/solver_templates/I_background_ode.template.json --binding-sheet <RUN_DIR>/binding_sheets/I_background_ode.bindings.json --output <RUN_DIR>/solver_configs/I_background_ode.json"
    }
  ]
}
