{
  "schema_version": "2.0",
  "module": "F",
  "title": "Post-Nuclear Plasma and Radiation Persistence",
  "parents": [
    "E"
  ],
  "children": [
    "G"
  ],
  "objective": "Carry isotope, plasma, radiation, neutrino, and transport states from nucleosynthesis into recombination without losing lineage or covariance.",
  "nbody_mode": "RELATIONAL_GRAMMAR_ACTIVE",
  "triadic_descent": {
    "CIF": "plasma/radiation/neutrino possibilities",
    "QV": "transport, scattering and persistence",
    "RFL": "post-nuclear state and covariance"
  },
  "derive_exactly": [
    "species/charge/plasma state from E",
    "radiation/neutrino transport and opacity ownership",
    "covariance-preserving transfer to G"
  ],
  "wolfram_calls": [
    "F-WL-001",
    "F-WL-002"
  ],
  "local_commands": [
    "python tools/run_reference_checks.py --module F --output <RUN_DIR>/reference_checks.json",
    "python tools/director.py solver-copy --module F --solver reaction_network --destination <RUN_DIR>",
    "python tools/materialize_solver_config.py --template <RUN_DIR>/solver_templates/F_reaction_network.template.json --binding-sheet <RUN_DIR>/binding_sheets/F_reaction_network.bindings.json --output <RUN_DIR>/solver_configs/F_reaction_network.json",
    "python tools/run_configured_solver.py --config <RUN_DIR>/solver_configs/F_reaction_network.json --output-dir <RUN_DIR>/solver_outputs/reaction_network",
    "python tools/director.py solver-copy --module F --solver transport --destination <RUN_DIR>",
    "python tools/materialize_solver_config.py --template <RUN_DIR>/solver_templates/F_transport.template.json --binding-sheet <RUN_DIR>/binding_sheets/F_transport.bindings.json --output <RUN_DIR>/solver_configs/F_transport.json",
    "python tools/run_configured_solver.py --config <RUN_DIR>/solver_configs/F_transport.json --output-dir <RUN_DIR>/solver_outputs/transport"
  ],
  "numerical_execution": [
    "charge-neutrality and transport manufactured case",
    "PSD covariance evolution",
    "restart from E"
  ],
  "required_outputs": [
    "plasma composition and ionization state",
    "radiation/neutrino persistence",
    "opacity and transport state",
    "source-transfer ownership",
    "H_F_to_G"
  ],
  "mandatory_gates": [
    "charge neutrality where derived",
    "energy and particle accounting",
    "covariance positive semidefinite",
    "replay from E"
  ],
  "forbidden_shortcuts": [
    "resetting to a textbook plasma",
    "dropping isotope or uncertainty channels"
  ],
  "hard_stop_conditions": [
    "composition lineage is lost",
    "charge/energy ledger fails",
    "covariance becomes non-PSD without diagnosed branch"
  ],
  "claim_boundary": "Post-nuclear RFC plasma state.",
  "operator_sequence": [
    "freeze exact parents and source hashes",
    "complete PRE_EXECUTION_LOCK.json before derivation execution",
    "run Wolfram calls in listed order and record outputs",
    "run manufactured reference checks",
    "derive/execute the actual parent-driven system",
    "run countermodels, ablations, convergence, restart, replay and independent reconstruction",
    "finalize output manifest only after files stop changing",
    "state strongest supported and unsupported claims",
    "commit and verify SHA/diff"
  ],
  "solver_bindings": [
    {
      "solver": "reaction_network",
      "template": "configured_runs/templates/F_reaction_network.template.json",
      "purpose": "Execute the post-nuclear plasma reaction network.",
      "copy_command": "python tools/director.py solver-copy --module F --solver reaction_network --destination <RUN_DIR>",
      "run_command": "python tools/run_configured_solver.py --config <RUN_DIR>/solver_configs/F_reaction_network.json --output-dir <RUN_DIR>/solver_outputs/reaction_network",
      "status": "UNBOUND_UNTIL_EXACT_PARENT_DERIVATION",
      "binding_sheet": "configured_runs/binding_sheets/F_reaction_network.bindings.json",
      "materialize_command": "python tools/materialize_solver_config.py --template <RUN_DIR>/solver_templates/F_reaction_network.template.json --binding-sheet <RUN_DIR>/binding_sheets/F_reaction_network.bindings.json --output <RUN_DIR>/solver_configs/F_reaction_network.json"
    },
    {
      "solver": "transport",
      "template": "configured_runs/templates/F_transport.template.json",
      "purpose": "Execute coupled plasma/radiation transport.",
      "copy_command": "python tools/director.py solver-copy --module F --solver transport --destination <RUN_DIR>",
      "run_command": "python tools/run_configured_solver.py --config <RUN_DIR>/solver_configs/F_transport.json --output-dir <RUN_DIR>/solver_outputs/transport",
      "status": "UNBOUND_UNTIL_EXACT_PARENT_DERIVATION",
      "binding_sheet": "configured_runs/binding_sheets/F_transport.bindings.json",
      "materialize_command": "python tools/materialize_solver_config.py --template <RUN_DIR>/solver_templates/F_transport.template.json --binding-sheet <RUN_DIR>/binding_sheets/F_transport.bindings.json --output <RUN_DIR>/solver_configs/F_transport.json"
    }
  ]
}
